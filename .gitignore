# =====================
# 資料庫檔案
# =====================
db.sqlite3

# =====================
# 虛擬環境檔案
# =====================
venv/
.virtualenv/

# =====================
# 第三方依賴檔案
# =====================
node_modules/
bower_components/

# =====================
# 編譯檔與暫存檔
# =====================
*.log
*.tmp
*.cache
*.out
*.class
*.o
*.so

# =====================
# 個人設定檔
# =====================
.vscode/
.idea/
*.iml

# =====================
# 作業系統產生的檔案
# =====================
.DS_Store
Thumbs.db
Desktop.ini

# =====================
# Python 快取檔案
# =====================
__pycache__/
*.pyc
*.pyo

# =====================
# 特定框架或工具相關檔案
# =====================

# Flask 或其他框架的 .env 檔案（存放機密資訊）
.env

# =====================
# 前端建置產物
# =====================
dist/
build/
*.min.js
*.min.css

# =====================
# 其他常見工具
# =====================
# 忽略 Mac 的 Spotlight 搜索資料
.Spotlight-V100
.Trashes

# 忽略特定 IDE 的暫存檔
*.swp
*.swo
*.bak

# 忽略壓縮檔案和備份檔案
*.zip
*.tar.gz
*.7z
*.bak
